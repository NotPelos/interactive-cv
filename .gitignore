playwright-report/
test-results/
playwright/.cache/

# --- Materiales personales (no públicos) ---
# personal/ vive en el repo privado NotPelos/cv-content.
# sync-content.mjs lo copia aquí antes del build.
personal/

# Archivos generados por sync-content.mjs (datos reales del owner).
# En el repo público solo existe profile.template.ts (placeholder).
apps/web/src/profile.ts

# Contenido del CV (copiado desde personal/ en sync-content.mjs)
apps/web/src/content/

# Avatar y OG image generados desde personal/avatar/
apps/web/source/
apps/web/public/avatar/
apps/web/public/og-image.png

# PDFs del CV generados por scripts/cv-pdf/generate-cv-pdf.mjs en cada build
# (CI ejecuta typst y los deja en public/; local también si tienes typst instalado).
apps/web/public/cv-es.pdf
apps/web/public/cv-en.pdf

# Build intermediates del generador Typst
apps/web/scripts/cv-pdf/build/
apps/web/scripts/cv-pdf/avatar.png
